# Service Configuration
SERVICE_HOST=localhost:50051

# Milvus Configuration
MILVUS_HOST=localhost:19530

# OpenAI Configuration
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key_here
# RERANK_ENABLED: when true, rerank retrieved chunks by relevance before returning (uses gRPC or HTTP reranker per RERANKER_MODEL_NAME)
RERANK_ENABLED=True
# COMPRESS_ENABLED: when true, compress retrieved context with an LLM (e.g. LLMLingua) before use
COMPRESS_ENABLED=True
# GRAPH_VECTOR_DIM: embedding dimension used for the Graph RAG vector store (e.g. in Milvus for graph nodes)
GRAPH_VECTOR_DIM=1024
# EMBEDDING_DIMENSION: dimension of embedding vectors produced by the embedding model (must match model output)
EMBEDDING_DIMENSION=1024
# CHUNK_SIZE: target size (in characters) for text chunks when splitting documents
CHUNK_SIZE=256
# CHUNK_OVERLAP: number of characters to overlap between consecutive chunks for continuity
CHUNK_OVERLAP=64
# MIN_CHUNK_TOKENS: minimum token count for a chunk; smaller chunks may be merged or dropped
MIN_CHUNK_TOKENS=50
PROMPT_REWRITE_MODEL=qwen3:0.6b
EMBEDDING_MODEL_NAME=bge-m3:latest
RERANKER_MODEL_NAME=ai/qwen3-reranker-vllm:0.6B
GRAPH_CREATE_MODEL=gpt-oss:latest

# Neo4j Configuration
NEO4J_HOST=localhost
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
NEO4J_BOLT_PORT=7687
NEO4J_URL=bolt://localhost:7687

COLLECTION_NAME=vector_rag

GRAPHRAG_ENABLED=True # Weather to use GraphRAG to store and retrieval info
